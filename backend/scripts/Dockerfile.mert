# syntax=docker/dockerfile:1
FROM python:3.12.12-slim-bookworm AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=2 -o Acquire::https::Timeout=30 update \
    && apt-get -o Acquire::Retries=2 -o Acquire::https::Timeout=30 install -y --no-install-recommends ffmpeg libgomp1 \
    && rm -rf /var/lib/apt/lists/*

FROM base AS dependencies
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m venv /opt/venv \
    && /opt/venv/bin/pip install torch==2.8.0 --index-url https://download.pytorch.org/whl/cu126 \
    && /opt/venv/bin/pip install transformers==4.38.2 numpy==1.26.4

FROM base AS runtime
ENV PATH=/opt/venv/bin:$PATH \
    HF_HOME=/output/huggingface \
    HF_HUB_DISABLE_TELEMETRY=1 \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    OMP_NUM_THREADS=2 \
    MKL_NUM_THREADS=2

COPY --from=dependencies /opt/venv /opt/venv
WORKDIR /app
COPY benchmark_mert.py serve_mert.py ./
USER 1000:1000
ENTRYPOINT ["python", "benchmark_mert.py"]
