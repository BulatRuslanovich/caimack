APP_ENV=development
LISTEN_ADDR=127.0.0.1:5199
DATABASE_URL=postgres://music:dev@127.0.0.1:55433/music
JWT_SIGNING_KEY=
STORAGE_ROOT=../storage
OWNER_USERNAME=admin
OWNER_PASSWORD=
RUST_LOG=info,sqlx=warn
MERT_URL=http://127.0.0.1:8090
RECOMMENDATIONS_ENABLED=false
