{
  "manifest_version": 3,
  "name": "Caimack VK Music",
  "version": "0.1.5",
  "description": "Search VK Music and import selected tracks into Caimack.",
  "key": "",
  "permissions": ["scripting"],
  "host_permissions": ["https://vk.ru/*", "https://vk.com/*"],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "externally_connectable": {
    "matches": [
      "https://music.caimack.ru/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
