POSTGRES_USER=music
POSTGRES_DB=music
POSTGRES_PASSWORD=

JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_MINUTES=10
JWT_REFRESH_TOKEN_DAYS=30

OWNER_USERNAME=admin
OWNER_PASSWORD=
OWNER_RESET_PASSWORD=false

MUSIC_STORAGE_PATH=./storage
MUSIC_LIBRARY_PATH=./library
LIBRARY_SCAN_INTERVAL_MINUTES=60

PUID=1000
PGID=1000

MAX_UPLOAD_BODY_BYTES=268435456

PUBLIC_DOMAIN=music.example.com
CAIMACK_VERSION=latest
HTTP_PORT=80
HTTPS_PORT=443

BACKEND_PORT=8080

# Optional: enables uncached TTML requests when Better Lyrics requires a key.
BETTER_LYRICS_API_KEY=

POSTGRES_MEMORY_LIMIT=1g
BACKEND_MEMORY_LIMIT=1g
FRONTEND_MEMORY_LIMIT=512m

RUST_LOG=info

POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
POSTGRES_WORK_MEM=32MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_TEMP_FILE_LIMIT=4GB
POSTGRES_MAX_WAL_SIZE=2GB
DATABASE_MAX_CONNECTIONS=40

# Shared slots for audio analysis and ffmpeg; blank derives from CPU count.
# Set to 1 on a small VPS to reserve resources for playback.
BACKGROUND_HEAVY_JOBS=

# MERT-Large (330M): auto detects NVIDIA/CUDA or AMD/ROCm when enabling.
# Use nvidia or amd to override. The selected Compose files persist across restarts.
MERT_GPU_BACKEND=auto
# AMD device group IDs are filled in by caimack.sh recommendations on.
# MERT_KFD_GID=
# MERT_RENDER_GID=
# Weights are cached between releases.
MERT_CACHE_PATH=./storage/models/mert
MERT_MEMORY_LIMIT=4g
# Start the GPU worker on demand; stop it after 5 minutes without embeddings.
# Set to 0 to keep a loaded worker resident until the service stops.
MERT_IDLE_TIMEOUT_SECONDS=300
# Includes downloading weights on the first request. Inference should finish
# before the API's 120-second request timeout.
MERT_LOAD_TIMEOUT_SECONDS=1800
MERT_INFERENCE_TIMEOUT_SECONDS=90

# Recommendations are disabled by default. Enable with docker-compose.recommendations.yml.
