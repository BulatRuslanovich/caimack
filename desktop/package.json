{
  "name": "caimack-desktop",
  "version": "1.1.2",
  "private": true,
  "productName": "Caimack",
  "desktopName": "caimack.desktop",
  "description": "Desktop client for Caimack music libraries",
  "license": "AGPL-3.0-only",
  "author": {
    "name": "Caimack contributors",
    "email": "noreply@github.com"
  },
  "homepage": "https://github.com/MX-Goliath/caimack",
  "main": "app/main.mjs",
  "type": "module",
  "scripts": {
    "build": "node ../frontend/node_modules/vite/bin/vite.js build --config vite.config.mjs",
    "start": "electron .",
    "test": "node --test",
    "test:smoke": "node test-support/smoke.mjs",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never && npm run prepare:arch",
    "prepare:arch": "node packaging/prepare-arch.mjs",
    "dist:windows": "npm run build && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "@streamparser/json": "0.0.26"
  }
}
